.nutrition-card{padding:26rpx;margin:24rpx 0;background:linear-gradient(145deg,#fff,#fffaf0);border:2rpx solid #f0dfd4;border-radius:24rpx;text-align:left;box-shadow:0 10rpx 30rpx rgba(120,78,52,.08)}.nutrition-title-row{display:flex;align-items:center;gap:12rpx}.nutrition-title-row image{width:50rpx;height:50rpx;flex:none}.nutrition-title{font-size:28rpx;color:#59483f;font-weight:700;display:block}.nutrition-status{display:block;color:#a94f35;font-size:22rpx;margin:10rpx 0}.nutrition-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin:20rpx 0}.nutrition-grid view{width:calc(50% - 8rpx);background:#e8f7f0;border-radius:16rpx;padding:14rpx;box-sizing:border-box}.nutrition-grid text{display:block;font-size:22rpx;color:#7f6d62}.nutrition-grid text:first-child{font-size:32rpx;color:#397562;font-weight:bold;margin-bottom:6rpx}.nutrition-note{display:block;font-size:22rpx;line-height:1.6;color:#7f6d62}.nutrition-source{margin-top:18rpx;font-size:22rpx;color:#a94f35;background:#fff0e9;padding:18rpx;border-radius:16rpx;border:0}
