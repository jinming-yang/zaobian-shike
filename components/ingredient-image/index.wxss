:host { display: block; overflow: hidden; }
.ingredient-picture, .ingredient-picture image { display: block; width: 100%; height: 100%; }
.ingredient-picture { overflow: hidden; border-radius: inherit; background:linear-gradient(145deg,#fffdf8,#fff1df); }
.ingredient-picture image { box-sizing:border-box; padding:5%; }
.picture-placeholder { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: #9b8b78; font-size: 16rpx; text-align: center; }
