.guide-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:9999;background:rgba(89,72,63,.48);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}.guide-card{position:relative;width:100%;max-width:620rpx;padding:118rpx 38rpx 38rpx;background:#fff9f0;border:2rpx solid #f0dfd4;border-radius:24rpx;box-sizing:border-box;box-shadow:0 24rpx 70rpx rgba(89,72,63,.18)}.guide-mascot{position:absolute;top:-118rpx;right:20rpx;width:210rpx;height:230rpx}.guide-count,.guide-title,.guide-body{display:block}.guide-count{color:#a94f35;font-size:23rpx;font-weight:700}.guide-title{margin:18rpx 0;font-size:36rpx;font-weight:bold;color:#59483f}.guide-body{font-size:27rpx;line-height:1.75;color:#7f6d62}.guide-actions{display:flex;gap:20rpx;margin-top:30rpx}.guide-actions button{flex:1;min-height:88rpx;font-size:24rpx;padding:12rpx;border:0;border-radius:44rpx;background:#e8f7f0;color:#397562}.guide-actions .guide-next{background:#ff946d;color:white;box-shadow:0 12rpx 26rpx rgba(255,148,109,.22)}
.guide-card{border:3rpx solid #efc681;box-shadow:0 9rpx 0 #e9d3aa,0 30rpx 80rpx rgba(89,72,63,.24)}.guide-actions button{border:2rpx solid #bfe8d7;box-shadow:0 5rpx 0 #cce9de}.guide-actions .guide-next{border-color:#ffb18e;background:linear-gradient(135deg,#ffad86,#ff8a62);box-shadow:0 6rpx 0 #d96b49,0 14rpx 28rpx rgba(255,148,109,.24)}
