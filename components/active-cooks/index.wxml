<view wx:if="{{activeCooks.length}}" class="active-cooks" style="bottom: {{bottomOffset}}rpx;">
  <view wx:if="{{expanded}}" class="cook-list">
    <view wx:for="{{activeCooks}}" wx:key="recipeId" class="cook-option" data-id="{{item.recipeId}}" bindtap="openCook" hover-class="tap-pressed" hover-stay-time="100">
      <image src="{{item.image}}" mode="aspectFill" />
      <view><text>{{item.name}}</text><text>{{item.statusText}}</text></view>
      <text class="cook-arrow">›</text>
    </view>
  </view>
  <view class="active-trigger" bindtap="toggleExpanded" hover-class="tap-pressed" hover-stay-time="100">
    <text class="active-dot"></text>
    <text>进行中的菜 {{activeCooks.length}}</text>
    <text>{{expanded ? '收起' : '查看'}}</text>
  </view>
</view>
