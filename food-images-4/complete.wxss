.complete-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  background: linear-gradient(180deg, #fffaf2 0%, #fff6ea 100%);
}

.complete-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: calc(184rpx + env(safe-area-inset-top)) 44rpx 44rpx;
  box-sizing: border-box;
  text-align: center;
}

.medal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #fff;
  background: #31584c;
  box-shadow: 0 14rpx 30rpx rgba(49, 88, 76, 0.25);
  font-size: 48rpx;
}

.complete-kicker,
.complete-title,
.dish-name,
.complete-message {
  display: block;
}

.weekly-result { margin-top:18rpx; padding:14rpx 24rpx; border-radius:24rpx; color:#31584c; background:rgba(255,255,255,.62); font-size:22rpx; }
.weekly-result text { color:#e8663d; font-size:30rpx; font-weight:750; }

.complete-kicker {
  margin-top: 30rpx;
  color: #b15b3f;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.complete-title {
  margin-top: 14rpx;
  color: #5e554a;
  font-size: 30rpx;
}

.dish-name {
  margin-top: 6rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 60rpx;
  font-weight: 700;
}

.dish-frame {
  position: relative;
  width: 100%;
  height: 472rpx;
  margin: 34rpx 0 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 12rpx solid #fff;
  border-radius: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(111, 70, 36, 0.2);
}

.dish-frame image {
  width: 100%;
  height: 100%;
}

.complete-message {
  max-width: 570rpx;
  color: #71675b;
  font-size: 24rpx;
  line-height: 1.75;
}

.complete-content .secondary-button {
  width: 100%;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.complete-back-button {
  position: fixed;
  left: 24rpx;
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 190rpx;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 36rpx;
  background: #31584c;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(49, 88, 76, 0.2);
}

.fireworks {
  pointer-events: none;
}

.fireworks,
.spark {
  position: absolute;
  inset: 0;
}

.spark::before,
.spark::after {
  position: absolute;
  width: 12rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #e8663d;
  content: '';
  animation: fall 2.8s infinite ease-in;
}

.spark::after {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #31584c;
  animation-delay: 0.8s;
}

.spark-0::before { left: 8%; animation-delay: .1s; }
.spark-1::before { left: 17%; animation-delay: 1.2s; background:#e1a43e; }
.spark-2::before { left: 27%; animation-delay: .5s; background:#759b82; }
.spark-3::before { left: 38%; animation-delay: 1.8s; }
.spark-4::before { left: 49%; animation-delay: .9s; background:#e1a43e; }
.spark-5::before { left: 60%; animation-delay: .2s; background:#759b82; }
.spark-6::before { left: 71%; animation-delay: 1.5s; }
.spark-7::before { left: 82%; animation-delay: .7s; background:#e1a43e; }
.spark-8::before { left: 93%; animation-delay: 2.1s; background:#759b82; }
.spark-9::after { left: 12%; animation-delay: 1.7s; }
.spark-10::after { left: 23%; animation-delay: .3s; background:#e1a43e; }
.spark-11::after { left: 35%; animation-delay: 1.1s; }
.spark-12::after { left: 46%; animation-delay: 2.2s; background:#759b82; }
.spark-13::after { left: 57%; animation-delay: .6s; background:#e1a43e; }
.spark-14::after { left: 67%; animation-delay: 1.4s; }
.spark-15::after { left: 77%; animation-delay: .15s; background:#759b82; }
.spark-16::after { left: 87%; animation-delay: 1.9s; background:#e1a43e; }
.spark-17::after { left: 96%; animation-delay: .95s; }

@keyframes fall {
  0% { transform: translateY(-80rpx) rotate(0); opacity: 0; }
  15% { opacity: 1; }
  100% { transform: translateY(1080rpx) rotate(400deg); opacity: 0; }
}
