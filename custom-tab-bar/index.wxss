.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 250, 242, 0.98);
  box-shadow: 0 -10rpx 28rpx rgba(67, 55, 39, 0.06);
}

.tab-divider {
  width: 100%;
  height: 2rpx;
  background: #d5caba;
}

.tab-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 92rpx;
  padding: 10rpx 112rpx 8rpx;
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 57rpx;
  box-sizing: border-box;
  border: 2rpx solid #c9beae;
  border-radius: 19rpx;
  color: #746b60;
  background: #fffdf9;
}

.tab-item-active {
  border-color: #31584c;
  color: #ffffff;
  background: #31584c;
  box-shadow: 0 8rpx 18rpx rgba(49, 88, 76, 0.2);
}

.tab-item { gap:6rpx; border-color:#f0dfd4; color:#7f6d62; background:#fff; }
.tab-item-active { border-color:#ff946d; color:#fff; background:#ff946d; box-shadow:0 8rpx 18rpx rgba(255,148,109,.22); }
.tab-icon { position:relative; width:30rpx; height:28rpx; flex:none; }
.tab-icon-home:before { content:""; position:absolute; left:5rpx; top:8rpx; width:18rpx; height:16rpx; border:3rpx solid currentColor; border-top:0; border-radius:3rpx; box-sizing:border-box; }
.tab-icon-home:after { content:""; position:absolute; left:5rpx; top:2rpx; width:17rpx; height:17rpx; border-left:3rpx solid currentColor; border-top:3rpx solid currentColor; transform:rotate(45deg); border-radius:3rpx 0 0 0; }
.tab-icon-profile:before { content:""; position:absolute; left:9rpx; top:1rpx; width:12rpx; height:12rpx; border:3rpx solid currentColor; border-radius:50%; box-sizing:border-box; }
.tab-icon-profile:after { content:""; position:absolute; left:4rpx; bottom:0; width:22rpx; height:13rpx; border:3rpx solid currentColor; border-radius:13rpx 13rpx 5rpx 5rpx; box-sizing:border-box; }

/* 华丽插画版底栏 */
.tab-bar { background:linear-gradient(180deg,rgba(255,253,246,.98),rgba(255,246,230,.99)); box-shadow:0 -12rpx 34rpx rgba(110,72,48,.12); }
.tab-divider { background:linear-gradient(90deg,transparent,#f4c8ad 18%,#ffd66b 50%,#bde7d7 82%,transparent); }
.tab-item { border:2rpx solid transparent; background:transparent; box-shadow:none; }
.tab-item-active { border-color:#ffb591; background:linear-gradient(135deg,#ffad86,#ff8d65); box-shadow:0 6rpx 0 #db6d4b,0 12rpx 22rpx rgba(255,148,109,.24); }

.tab-label {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.tap-pressed{opacity:.7;transform:scale(.96)}
.tab-art { width:38rpx; height:38rpx; flex:none; opacity:.72; }
.tab-item-active .tab-art { opacity:1; transform:translateY(-1rpx); }
