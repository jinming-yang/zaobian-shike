<view wx:if="{{recipe}}" class="page-shell complete-page safe-bottom">
  <button class="complete-back-button" style="top: {{backButtonTop}}px;" bindtap="exitToHome">← 返回主页</button>
  <active-cooks bottom-offset="180" />
  <view class="fireworks">
    <view wx:for="{{sparks}}" wx:key="*this" class="spark spark-{{index}}"></view>
  </view>

  <view class="complete-content">
    <view class="complete-mascots"><image src="/assets/characters/xiaozao-welcome.png" mode="aspectFit" /><image src="/assets/characters/danzai-reminder.png" mode="aspectFit" /></view>
    <view class="medal">✓</view>
    <text class="complete-kicker">DISH COMPLETE</text>
    <text class="complete-title">恭喜你完成烹饪</text>
    <text class="dish-name">{{recipe.name}}</text>
    <view class="dish-frame">
      <image src="{{heroImage || recipe.image}}" binderror="useFallbackImage" mode="aspectFill" />
    </view>
    <text class="complete-message">趁热享用吧。每一次亲手完成，都是生活里值得庆祝的小事。</text>
    <view class="weekly-result">本周已经完成 <text>{{weeklyCount}}</text> 道菜</view>
    <nutrition-card nutrition="{{nutrition}}" title="这道菜的营养参考" />
    <button class="secondary-button" open-type="share">分享这道菜的做法</button>
  </view>
</view>

<page-tutorial id="page-guide" page-key="{{tutorialKey}}" steps="{{tutorialSteps}}" />
