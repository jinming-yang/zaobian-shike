.cook-page {
  height: 100vh;
  overflow: hidden;
  background: #fffaf2;
}

.cook-loading {
  padding: calc(220rpx + env(safe-area-inset-top)) 48rpx 48rpx;
  text-align: center;
  color: #31584c;
  font-size: 29rpx;
  line-height: 1.6;
}

.cook-loading text { display: block; margin-bottom: 36rpx; }
.cook-loading button { margin: 20rpx 0 0; }

.exit-dialog-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:2500; display:flex; align-items:center; justify-content:center; padding:40rpx; box-sizing:border-box; background:rgba(0,0,0,.48); }
.exit-dialog-card { width:100%; max-width:620rpx; max-height:85vh; overflow-y:auto; padding:38rpx 30rpx 30rpx; box-sizing:border-box; border-radius:30rpx; background:#fffaf2; }
.exit-dialog-title { display:block; margin-bottom:24rpx; color:#2c302b; font-size:34rpx; font-weight:700; text-align:center; }
.exit-dialog-note { display:block; margin-top:12rpx; color:#756b60; font-size:25rpx; line-height:1.7; }
.exit-dialog-actions { display:flex; flex-direction:column; gap:14rpx; margin-top:30rpx; }
.exit-dialog-actions .exit-dialog-button { width:100%; min-height:84rpx; margin:0; padding:18rpx 16rpx; box-sizing:border-box; border-radius:22rpx; font-size:27rpx; font-weight:700; line-height:1.5; }
.exit-dialog-button::after { border:0; }
.exit-continue { color:#fff; background:#31584c; }
.exit-save { color:#31584c; background:#eaf1ed; }
.exit-end { color:#b45134; background:#f8e4db; }

.cook-topbar {
  display: flex;
  align-items: center;
  padding: calc(24rpx + env(safe-area-inset-top)) 30rpx 20rpx;
}

.close-button,
.progress-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border-radius: 50%;
}

.close-button {
  color: #685f54;
  background: #eee6da;
  font-size: 43rpx;
}

.progress-number {
  color: #fff;
  background: #31584c;
  font-family: Georgia, serif;
  font-size: 27rpx;
}

.progress-copy {
  flex: 1;
  text-align: center;
}

.progress-copy text {
  display: block;
}

.progress-copy text:first-child {
  font-size: 26rpx;
  font-weight: 700;
}

.progress-copy text:last-child {
  margin-top: 4rpx;
  color: #948777;
  font-size: 20rpx;
}

.progress-track {
  height: 6rpx;
  background: #e9e0d4;
}

.progress-track view {
  height: 100%;
  border-radius: 0 6rpx 6rpx 0;
  background: #e8663d;
  transition: width 0.3s ease;
}

.step-scroll {
  height: calc(100vh - 330rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
}

.step-content {
  padding: 30rpx 32rpx 46rpx;
}

.step-image {
  width: 100%;
  height: 560rpx;
  border-radius: 32rpx;
  background: #e9e0d4;
  box-shadow: 0 18rpx 44rpx rgba(77, 52, 32, 0.12);
}

.step-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 560rpx;
  box-sizing: border-box;
  padding: 36rpx;
  border: 2rpx dashed #c9d4ce;
  border-radius: 32rpx;
  color: #685f54;
  background: #f2f5ef;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.image-retry-button {
  margin: 24rpx 0 0;
  padding: 16rpx 28rpx;
  color: #31584c;
  background: #fff;
  border-radius: 40rpx;
  font-size: 24rpx;
}

.step-image-caption {
  margin-top: 14rpx;
  color: #948777;
  font-size: 21rpx;
  line-height: 1.6;
}

.step-label {
  display: inline-block;
  margin-top: 34rpx;
  padding: 8rpx 15rpx;
  border-radius: 14rpx;
  color: #b45235;
  background: #f5dfd4;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.step-title,
.step-text {
  display: block;
}

.step-title {
  margin-top: 18rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 48rpx;
  font-weight: 700;
}

.step-text {
  margin-top: 18rpx;
  color: #665e54;
  font-size: 29rpx;
  line-height: 1.8;
}

.sequence-guide {
  margin:22rpx 0;
  padding:22rpx 24rpx;
  border:2rpx solid #f0c99f;
  border-radius:22rpx;
  background:#fff8e7;
  box-shadow:0 6rpx 0 #f2dfbd;
}
.sequence-guide-title,.sequence-guide-order,.sequence-guide-note { display:block; }
.sequence-guide-title { color:#9d4d35; font-size:23rpx; font-weight:800; }
.sequence-guide-order { margin-top:12rpx; color:#59483f; font-size:28rpx; font-weight:800; line-height:1.55; }
.sequence-guide-note { margin-top:8rpx; color:#7b695e; font-size:21rpx; line-height:1.55; }

.timer-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #31584c;
  color: #fff;
}

.timer-card.done {
  background: #527866;
}

.timer-eyebrow {
  color: #cbd9d3;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

.timer-value {
  margin: 12rpx 0 6rpx;
  font-family: "SF Mono", Consolas, monospace;
  font-size: 82rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.timer-status {
  min-height: 36rpx;
  color: #d5e1dc;
  font-size: 22rpx;
}

.pulse {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #ffb866;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  50% { opacity: 0.35; transform: scale(0.75); }
}

.timer-button {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  border-radius: 38rpx;
  color: #31584c;
  background: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.timer-button::after { border: 0; }
.timer-button[disabled] { opacity: 0.75; }

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 242, 0.96);
  box-shadow: 0 -10rpx 36rpx rgba(77, 52, 32, 0.07);
}

.parallel-button {
  width: 100%;
  height: 66rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid #31584c;
  border-radius: 34rpx;
  color: #31584c;
  background: #f7fbf9;
  font-size: 24rpx;
  font-weight: 700;
}

.parallel-button::after { border: 0; }

.step-actions { display: flex; align-items: stretch; gap: 18rpx; }
.step-actions .primary-button { flex: 1; width: auto; min-width: 0; margin: 0; padding-left: 16rpx; padding-right: 16rpx; }
.previous-button { width: 180rpx; flex: none; margin: 0; border: 2rpx solid #31584c; border-radius: 50rpx; color: #31584c; background: #f7fbf9; font-size: 28rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.previous-button::after { border: 0; }
.previous-button[disabled] { border-color: #d7d2c9; color: #aaa196; background: #f0ede7; }

.heat-guide { margin-top: 28rpx; padding: 26rpx; border: 2rpx solid #ead8b9; border-radius: 26rpx; background: #fff5e3; }
.heat-guide-label { display: inline-block; padding: 5rpx 12rpx; border-radius: 12rpx; color: #ad5c30; background: #f8e1be; font-size: 20rpx; }
.heat-guide-title { display: block; margin: 14rpx 0 18rpx; color: #594530; font-size: 29rpx; font-weight: 700; }
.heat-guide-cue { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 12rpx; color: #75634e; font-size: 24rpx; line-height: 1.75; }
.heat-guide-dot { flex: none; color: #d77a55; }
.heat-guide-warning { display: block; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e8d7bb; color: #a44e32; font-size: 23rpx; line-height: 1.75; }

/* 奶油元气厨房 · 阶段二视觉层 */
.cook-page { background:var(--color-bg-page); color:var(--color-text-primary); }
.close-button { color:var(--color-brand-deep); background:var(--color-brand-soft); }
.progress-number { background:var(--color-brand); box-shadow:0 8rpx 18rpx rgba(255,148,109,.22); }
.progress-track { background:#f1e4db; }
.progress-track view { background:var(--color-brand); }
.step-image,.step-image-placeholder { border-radius:24rpx; }
.step-label { color:var(--color-brand-deep); background:var(--color-brand-soft); }
.step-title { color:var(--color-text-primary); }
.step-text { color:var(--color-text-secondary); }
.timer-card { position:relative; overflow:hidden; color:var(--color-text-primary); background:linear-gradient(145deg,var(--color-butter-soft),#fff); border:2rpx solid #f1dca2; box-shadow:var(--shadow-card); }
.timer-card.running { border-color:var(--color-brand); }
.timer-card.done { border-color:var(--color-mint); background:var(--color-mint-soft); }
.timer-mascot { position:absolute; right:-10rpx; top:-6rpx; width:140rpx; height:140rpx; opacity:.92; }
.timer-eyebrow,.timer-status { color:var(--color-text-secondary); }
.timer-value { color:var(--color-brand-deep); }
.timer-button { position:relative; z-index:1; color:#fff; background:var(--color-brand); }
.pulse { background:var(--color-brand); }
.bottom-action { background:rgba(255,249,240,.98); }
.parallel-button,.previous-button { border-color:var(--color-mint); color:var(--color-mint-deep); background:var(--color-mint-soft); }
.exit-dialog-card { border:2rpx solid var(--color-border); border-radius:24rpx; background:var(--color-bg-page); }
.exit-continue { background:var(--color-brand); }
.exit-save { color:var(--color-mint-deep); background:var(--color-mint-soft); }
