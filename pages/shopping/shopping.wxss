.shopping-page { min-height:100vh; padding:30rpx 28rpx calc(50rpx + env(safe-area-inset-bottom)); background:#f7f3ea; }
.shopping-summary { padding:28rpx; border-radius:30rpx; color:#fff; background:#31584c; }.shopping-summary > view { display:flex; align-items:flex-end; justify-content:space-between; gap:18rpx; }.shopping-summary > view text:first-child { font-size:35rpx; font-weight:750; }.shopping-summary > view text:last-child { color:#d8e4df; font-size:20rpx; }.shopping-summary > text { display:block; margin-top:15rpx; color:#cbd9d3; font-size:19rpx; line-height:1.55; }
.bulk-actions { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin:18rpx 0 22rpx; }.bulk-actions button { height:68rpx; border-radius:22rpx; color:#31584c; background:#e6efeb; font-size:22rpx; font-weight:700; }.bulk-actions button:last-child { color:#a54f38; background:#f7e6de; }.bulk-actions button::after { border:0; }
.shopping-list { display:flex; flex-direction:column; gap:14rpx; }.shopping-row { display:flex; align-items:center; padding:16rpx; border:2rpx solid transparent; border-radius:26rpx; background:#fff; }.shopping-row.purchased { border-color:#cfddd7; background:#f1f6f3; opacity:.78; }.shopping-row > ingredient-image { width:82rpx; height:82rpx; flex:none; border-radius:20rpx; }
.item-copy { flex:1; min-width:0; margin:0 14rpx; }.item-copy > view { display:flex; justify-content:space-between; gap:10rpx; }.item-copy > view text:first-child { overflow:hidden; color:#302d27; font-size:24rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.item-copy > view text:last-child { flex:none; color:#b15a3e; font-size:21rpx; font-weight:700; text-align:right; }.item-copy > text { display:block; margin-top:7rpx; overflow:hidden; color:#9a8e7f; font-size:17rpx; text-overflow:ellipsis; white-space:nowrap; }.purchased .item-copy > view text:first-child { text-decoration:line-through; }
.item-actions { display:flex; flex-direction:column; gap:8rpx; width:92rpx; }.item-actions button { width:92rpx; height:48rpx; border-radius:16rpx; font-size:18rpx; font-weight:650; }.item-actions button::after { border:0; }.purchased-button { color:#31584c; background:#e4efea; }.delete-button { color:#aa5039; background:#fae8e1; }
.shopping-empty { display:flex; flex-direction:column; align-items:center; padding:110rpx 30rpx; color:#9a8e7f; text-align:center; }.shopping-empty text:first-child { display:flex; align-items:center; justify-content:center; width:90rpx; height:90rpx; border-radius:50%; color:#fff; background:#c8d8d1; font-size:44rpx; }.shopping-empty text:nth-child(2) { margin-top:24rpx; color:#5c554d; font-size:28rpx; font-weight:700; }.shopping-empty text:last-child { margin-top:10rpx; font-size:20rpx; line-height:1.6; }
