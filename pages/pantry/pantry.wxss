.pantry-page {
  padding: 34rpx 32rpx 0;
  background: #f7f3ea;
}

.intro-card {
  padding: 34rpx 32rpx;
  border-radius: 32rpx;
  color: #fff;
  background: #31584c;
  box-shadow: 0 18rpx 42rpx rgba(49, 88, 76, 0.18);
}

.eyebrow,
.page-title,
.page-subtitle {
  display: block;
}

.eyebrow {
  color: #d4e2dc;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: 12rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #d4e2dc;
  font-size: 23rpx;
  line-height: 1.65;
}

.search-section {
  position: relative;
  z-index: 3;
  margin-top: 28rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(132, 105, 74, 0.12);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(83, 61, 39, 0.07);
}

.search-icon {
  margin-right: 16rpx;
  color: #8f826f;
  font-size: 42rpx;
}

.search-box input {
  flex: 1;
  font-size: 27rpx;
}

.clear {
  padding: 10rpx;
  color: #9e9487;
  font-size: 34rpx;
}

.search-results {
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 18rpx 46rpx rgba(60, 45, 30, 0.14);
}

.search-result {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid #eee7dc;
}

.search-result:last-child {
  border-bottom: 0;
}

.search-result ingredient-image {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 50%;
}

.search-result > view:nth-child(2) {
  flex: 1;
  margin-left: 18rpx;
}

.search-result text {
  display: block;
  font-size: 25rpx;
}

.search-result view text:last-child {
  margin-top: 4rpx;
  color: #9c9081;
  font-size: 19rpx;
}

.add-mark {
  color: #e8663d;
  font-size: 40rpx !important;
}

.no-match {
  padding: 24rpx;
  color: #978b7c;
  text-align: center;
  font-size: 22rpx;
}

.selected-section {
  margin-top: 38rpx;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 0 4rpx 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.section-heading text:last-child {
  color: #9c9081;
  font-size: 21rpx;
  font-weight: 400;
}

.selected-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 46rpx 20rpx;
  border: 2rpx dashed #d9cdbd;
  border-radius: 26rpx;
  color: #6f665b;
  font-size: 25rpx;
}

.selected-empty text:last-child {
  margin-top: 8rpx;
  color: #9c9081;
  font-size: 21rpx;
}

.selected-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.selected-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 14rpx 16rpx;
  border-radius: 24rpx;
  background: #fff;
}

.selected-row > ingredient-image {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 50%;
}

.selected-name {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-control {
  display: flex;
  align-items: center;
  height: 58rpx;
  overflow: hidden;
  border: 2rpx solid #e5dbce;
  border-radius: 29rpx;
}

.amount-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 58rpx;
  color: #31584c;
  background: #edf3f0;
  font-size: 30rpx;
}

.amount-control input {
  width: 76rpx;
  height: 58rpx;
  padding: 0 4rpx;
  text-align: right;
  font-size: 23rpx;
}

.unit {
  padding-right: 8rpx;
  color: #807568;
  font-size: 20rpx;
}

.remove-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 58rpx;
  margin-left: 10rpx;
  color: #ad9f8e;
  font-size: 30rpx;
}

.find-button {
  margin-top: 28rpx;
  width: 100%;
}

.recommendations {
  margin-top: 52rpx;
}

.result-heading text {
  display: block;
}

.result-heading text:first-child {
  font-size: 32rpx;
  font-weight: 700;
}

.result-heading text:last-child {
  margin-top: 8rpx;
  color: #978b7c;
  font-size: 21rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.result-card {
  display: flex;
  align-items: center;
  min-height: 150rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(83, 61, 39, 0.06);
}

.result-card > image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 24rpx;
}

.result-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.result-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-status {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
}

.result-status.ready {
  color: #31584c;
  background: #dfeae4;
}

.result-status.near {
  color: #9b5b24;
  background: #fff0d8;
}

.result-subtitle,
.ready-note,
.missing-note {
  display: block;
}

.result-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: #918575;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ready-note,
.missing-note {
  margin-top: 9rpx;
  font-size: 20rpx;
  line-height: 1.45;
}

.ready-note { color: #3e7463; }
.missing-note { color: #b2603f; }
.result-allergy { display:block; margin-top:6rpx; color:#b3422e; font-size:19rpx; font-weight:650; }

.chevron {
  margin-left: 8rpx;
  color: #b7aa99;
  font-size: 44rpx;
}

/* 奶油元气厨房 · 阶段二视觉层 */
.pantry-page { background:var(--color-bg-page); }
.intro-card { position:relative; display:flex; min-height:180rpx; padding:28rpx 190rpx 28rpx 28rpx; overflow:hidden; color:var(--color-text-primary); background:linear-gradient(135deg,var(--color-butter-soft),#fff); border:2rpx solid #f2dfaa; border-radius:24rpx; box-shadow:var(--shadow-card); }
.intro-copy { min-width:0; }
.intro-card .eyebrow { color:var(--color-brand-deep); }
.intro-card .page-title { font-size:38rpx; }
.intro-card .page-subtitle { color:var(--color-text-secondary); font-size:21rpx; }
.intro-mascot { position:absolute; right:12rpx; bottom:-6rpx; width:176rpx; height:176rpx; }
.search-box,.search-results,.selected-row,.result-card { border-color:var(--color-border); background:var(--color-bg-card); box-shadow:var(--shadow-card); }
.search-box,.search-results,.selected-row,.result-card,.selected-empty { border-radius:24rpx; }
.amount-control { border-color:var(--color-border); background:#fff; }
.amount-button { min-width:58rpx; color:var(--color-brand-deep); background:var(--color-brand-soft); }
.result-status.ready { color:var(--color-mint-deep); background:var(--color-mint-soft); }
.result-status.near { color:#8a641f; background:var(--color-butter-soft); }
.add-mark { color:var(--color-brand)!important; }
