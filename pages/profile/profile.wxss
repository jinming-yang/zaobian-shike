.profile-page { padding: 34rpx 32rpx calc(150rpx + env(safe-area-inset-bottom)); background: #f7f3ea; }
.nutrient-tabs { display:flex; gap:8rpx; margin-top:18rpx; }
.nutrient-tabs .nutrient-tab { flex:1; min-width:0; min-height:72rpx; padding:10rpx 4rpx; border:2rpx solid #dce5df; border-radius:16rpx; color:#527866; background:#f1f5f2; font-size:22rpx; }
.nutrient-tabs .nutrient-tab.active { color:#fff; background:#31584c; border-color:#31584c; font-weight:700; }
.profile-card { display:flex; align-items:center; padding:30rpx; border-radius:32rpx; color:#fff; background:#31584c; }
.avatar { display:flex; align-items:center; justify-content:center; width:84rpx; height:84rpx; border-radius:50%; color:#31584c; background:#f1d6ab; font-family:Georgia,"Songti SC",serif; font-size:38rpx; font-weight:700; }
.profile-copy { flex:1; margin-left:20rpx; }
.profile-copy text { display:block; }
.profile-copy text:first-child { font-size:32rpx; font-weight:700; }
.profile-copy text:last-child { margin-top:6rpx; color:#cbd9d3; font-size:21rpx; }
.general-settings-entry { display:flex; align-items:center; justify-content:space-between; min-height:88rpx; box-sizing:border-box; margin-top:18rpx; padding:18rpx 24rpx; border-radius:24rpx; color:#31584c; background:#fff; font-size:26rpx; font-weight:650; }
.general-settings-entry text:last-child { color:#9c9081; font-size:34rpx; font-weight:400; }
.preference-card { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:18rpx; }
.preference-card > view { padding:22rpx; min-height:88rpx; box-sizing:border-box; border-radius:24rpx; background:#fff; }
.preference-card text { display:block; }
.preference-card text:first-child { font-size:22rpx; font-weight:700; }
.preference-card .preference-summary { margin-top:8rpx; color:#948777; font-size:19rpx; font-weight:400; line-height:1.45; }
.report-section { margin-top:38rpx; }
.report-tabs { display:flex; padding:6rpx; border-radius:25rpx; background:#e9e1d5; }
.report-tabs view { flex:1; padding:15rpx; border-radius:21rpx; text-align:center; color:#756a5c; font-size:23rpx; }
.report-tabs .active { color:#fff; background:#31584c; font-weight:700; }
.report-card { display:grid; grid-template-columns:1fr 1fr; gap:10rpx; margin-top:16rpx; padding:24rpx 14rpx; border-radius:28rpx; background:#fff; }
.report-number { text-align:center; }
.report-number text { display:block; }
.report-number text:first-child { color:#e8663d; font-size:40rpx; font-weight:750; }
.report-number text:last-child { margin-top:4rpx; color:#8e8273; font-size:18rpx; }
.report-dishes { margin-top:14rpx; overflow:hidden; border-radius:24rpx; background:#fff; }
.report-dishes > view { display:flex; align-items:center; padding:14rpx 18rpx; border-bottom:1rpx solid #eee7dc; }
.report-dishes image { width:58rpx; height:58rpx; border-radius:50%; }
.report-dishes view view { margin-left:16rpx; }
.report-dishes text { display:block; font-size:22rpx; }
.report-dishes view view text:last-child { margin-top:4rpx; color:#9c9081; font-size:18rpx; }
.section-heading { display:flex; justify-content:space-between; margin:42rpx 4rpx 18rpx; font-size:30rpx; font-weight:700; }
.section-heading text:last-child { color:#9c9081; font-size:21rpx; font-weight:400; }
.favorite-scroll { width:calc(100% + 32rpx); }
.favorite-track { display:flex; gap:16rpx; width:max-content; padding-right:32rpx; }
.favorite-card { width:210rpx; overflow:hidden; border-radius:24rpx; background:#fff; }
.favorite-card image { width:210rpx; height:150rpx; }
.favorite-card text { display:block; padding:16rpx; overflow:hidden; font-size:23rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
.history-heading { margin-top:46rpx; }
.history-list { display:flex; flex-direction:column; gap:14rpx; }
.history-row { display:flex; align-items:center; padding:16rpx; border-radius:26rpx; background:#fff; }
.history-row > image { width:94rpx; height:94rpx; flex:none; border-radius:22rpx; }
.history-copy { flex:1; min-width:0; margin-left:18rpx; }
.history-copy > view:first-child { display:flex; justify-content:space-between; gap:10rpx; }
.history-copy > view:first-child > text:first-child { overflow:hidden; font-size:25rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.history-copy > text { display:block; margin-top:6rpx; color:#9c9081; font-size:18rpx; }
.done,.pending { flex:none; padding:4rpx 9rpx; border-radius:13rpx; font-size:17rpx; }
.done { color:#31584c; background:#dfeae4; }.pending { color:#a95a36; background:#f8e2d6; }
.history-progress { height:7rpx; margin-top:10rpx; overflow:hidden; border-radius:5rpx; background:#eee7dc; }
.history-progress view { height:100%; background:#e8663d; }
.history-actions { display:flex; flex-direction:column; align-items:center; justify-content:center; align-self:stretch; margin-left:8rpx; }
.delete-history { padding:8rpx 10rpx; border-radius:14rpx; color:#b34f38; background:#fae9e2; font-size:18rpx; }
.chevron { margin-left:8rpx; color:#b7aa99; font-size:42rpx; }
.history-actions .chevron { margin:2rpx 0 0; font-size:32rpx; }
.empty-card { padding:34rpx 20rpx; border-radius:24rpx; color:#9c9081; background:#fff; text-align:center; font-size:21rpx; }
